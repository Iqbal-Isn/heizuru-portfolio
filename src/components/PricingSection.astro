---
import { Icon } from "astro-icon/components";
import { pricingPackages } from "../data/packages";
---

<section class="bg-ink">
  <div class="mx-auto max-w-[1200px] px-5 py-12 md:px-8 md:py-24">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        pricingPackages.map((pkg, i) => (
          <article
            class:list={[
              "flex flex-col rounded-2xl p-8",
              pkg.featured
                ? "bg-surface text-ink shadow-card"
                : "bg-deep text-white",
            ]}
            data-reveal
            style={`--reveal-delay: ${i * 110}`}
          >
            {pkg.featured && (
              <span class="mb-5 inline-flex w-fit items-center rounded-full bg-coral px-3.5 py-1.5 text-xs font-semibold text-white">
                Paling Diminati
              </span>
            )}
            <h2 class="text-xl font-bold tracking-tight">{pkg.name}</h2>
            <p
              class:list={[
                "mt-2 text-sm leading-relaxed",
                pkg.featured ? "text-steel" : "text-zinc-400",
              ]}
            >
              {pkg.tagline}
            </p>
            <div class="mt-6">
              <p
                class:list={[
                  "text-xs font-medium uppercase tracking-wider",
                  pkg.featured ? "text-steel" : "text-zinc-500",
                ]}
              >
                {pkg.note}
              </p>
              <p class="mt-1.5 text-[28px] leading-none font-bold tracking-tight">
                {pkg.price}
              </p>
            </div>
            <p
              class:list={[
                "mt-4 inline-flex items-center gap-2 text-sm font-medium",
                pkg.featured ? "text-ink" : "text-zinc-300",
              ]}
            >
              <Icon name="ph:clock" class="size-4" aria-hidden="true" />
              {pkg.timeline}
            </p>
            <ul
              class:list={[
                "mt-7 flex-1 space-y-3.5 border-t pt-7 text-sm leading-relaxed",
                pkg.featured
                  ? "border-whisper/60 text-steel"
                  : "border-white/10 text-zinc-300",
              ]}
            >
              {pkg.features.map((feature) => (
                <li class="flex gap-2.5">
                  <Icon
                    name="ph:check"
                    class:list={[
                      "mt-0.5 size-4 shrink-0",
                      pkg.featured ? "text-coral-deep" : "text-coral",
                    ]}
                    aria-hidden="true"
                  />
                  {feature}
                </li>
              ))}
            </ul>
            <a
              href="/kontak"
              class:list={[
                "mt-8 inline-flex h-12 items-center justify-center rounded-full text-[15px] font-semibold transition-transform duration-300 ease-out hover:-translate-y-px motion-safe:active:translate-y-0",
                pkg.featured
                  ? "bg-coral text-white"
                  : "border border-white/25 text-white hover:border-white/60",
              ]}
            >
              Pilih paket ini
            </a>
          </article>
        ))
      }
    </div>
    <p class="mt-8 text-center text-sm text-zinc-500">
      Harga estimasi awal — final ditentukan setelah diskusi scope.
    </p>
  </div>
</section>